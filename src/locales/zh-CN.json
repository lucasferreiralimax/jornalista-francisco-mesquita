  "history": {
    "title": "学校历史",
    "intro": "学校以记者弗朗西斯科·梅斯基塔命名。他领导《圣保罗州报》四十余年，亲历了圣保罗和巴西历史上的重要时刻。",
    "timeline": [
      {
        "year": "1893",
        "text": "4月22日生于圣保罗，父亲是《圣保罗州报》社长胡里奥·梅斯基塔。"
      },
      {
        "year": "1916",
        "text": "毕业于圣弗朗西斯科广场法学院。1913年曾是保利斯塔诺竞技俱乐部的最佳射手。"
      },
      {
        "year": "1927",
        "text": "父亲去世后，与兄长小胡里奥·梅斯基塔共同执掌报社。"
      },
      {
        "year": "1932",
        "text": "作为志愿者参加护宪革命，被捕后流亡葡萄牙。"
      },
      {
        "year": "1934",
        "text": "当选制宪议员，参与创建圣保罗大学（USP）。"
      },
      {
        "year": "1940",
        "text": "“新国家”时期被拘押40天，报社直到1945年都处于政府管控之下。"
      },
      {
        "year": "1969",
        "text": "11月8日于圣保罗逝世，享年76岁。"
      },
      {
        "year": "1970",
        "text": "1月21日的州政府法令将当时的大众花园州立中学命名为“记者弗朗西斯科·梅斯基塔”。"
      }
    ]
  },
